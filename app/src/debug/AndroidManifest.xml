<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug builds only: lets QA trigger a crash without touching the UI. -->
        <receiver
            android:name=".debug.DebugCrashReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="dev.reclaim.app.DEBUG_CRASH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
